rules_version = '2';

// Security rules for "Alqasr Almalaky Calendar".
// Deploy: Firebase console -> Firestore Database -> Rules (paste & Publish),
//         or `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true;
    }
    function isAdmin() {
      return isActive() && profile().role == 'admin';
    }

    // ---- App users (profile, role and tied devices) ----
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // A user may tie their FIRST device to themselves (auto-bind), nothing else.
        || (signedIn() && request.auth.uid == uid
            && resource.data.get('active', false) == true
            && resource.data.get('devices', []).size() == 0
            && request.resource.data.devices.size() == 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devices', 'updatedAt']));
    }

    // ---- Requests to approve a new device: id = {uid}_{deviceId} ----
    match /deviceRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && requestId.matches(request.auth.uid + '_.+'));
      allow create, update: if isAdmin()
        || (signedIn() && requestId.matches(request.auth.uid + '_.+')
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // ---- Reservations ----
    match /events/{eventId} {
      allow read, write: if isActive();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
