{
    "namespace": "Reminders",
    "bridge_functions": [
        {
            "name": "Reminders.Schedule",
            "android": "com.alqasr.reminders.ReminderFunctions.Schedule",
            "description": "Schedule (or replace) a local notification at a given time"
        },
        {
            "name": "Reminders.Cancel",
            "android": "com.alqasr.reminders.ReminderFunctions.Cancel",
            "description": "Cancel a scheduled notification"
        },
        {
            "name": "Reminders.CancelAll",
            "android": "com.alqasr.reminders.ReminderFunctions.CancelAll",
            "description": "Cancel every scheduled notification of this app"
        },
        {
            "name": "Reminders.RequestPermission",
            "android": "com.alqasr.reminders.ReminderFunctions.RequestPermission",
            "description": "Ask for the notification permission (Android 13+)"
        }
    ],
    "android": {
        "min_version": 26,
        "permissions": [
            "android.permission.POST_NOTIFICATIONS"
        ],
        "dependencies": {
            "implementation": [
                "androidx.work:work-runtime-ktx:2.9.1"
            ]
        }
    },
    "events": []
}
