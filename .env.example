APP_NAME="Alqasr Almalaky Calendar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# NativePHP Mobile
# ---------------------------------------------------------------
NATIVEPHP_APP_ID=com.alqasr.almalaky.calendar
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_VERSION_CODE=1
NATIVEPHP_START_URL=/
# This app is built with Livewire + Tailwind screens rendered in the web view.
NATIVEPHP_BOOT_MODE=web
NATIVEPHP_ANDROID_COLOR_PRIMARY=#C9890F
NATIVEPHP_ANDROID_COLOR_PRIMARY_NIGHT=#EDB43F
NATIVEPHP_ANDROID_COLOR_ON_PRIMARY=#0C1A2D

# ---------------------------------------------------------------
# Firebase (Authentication + Cloud Firestore, REST API)
# Firebase console -> Project settings -> General -> "Web API Key" & "Project ID"
# ---------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)

# How often (seconds) the app syncs with Firebase while it is open
ALQASR_SYNC_INTERVAL=30
# Users without "@" in their login get this domain appended (username login)
ALQASR_USERNAME_DOMAIN=alqasr-almalaky.app
# Tie the first device a user logs in from automatically (others need admin approval)
ALQASR_AUTO_BIND_FIRST_DEVICE=true
ALQASR_CURRENCY_SYMBOL=₪
ALQASR_CURRENCY_CODE=ILS
ALQASR_TIMEZONE=Asia/Hebron
# Reminder notification N days before each reservation, at this hour (24h)
ALQASR_REMINDER_DAYS=3
ALQASR_REMINDER_HOUR=10
# GitHub repo (owner/name) whose Releases provide app updates; set automatically by the release workflow
ALQASR_UPDATE_REPO=
